# Clave de la API de Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Token del bot de Telegram, te lo da @BotFather
TELEGRAM_BOT_TOKEN=

# Solo se procesan mensajes que vengan de este chat. Para averiguarlo:
# mandale un mensaje al bot y mirá `message.chat.id` en
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ALLOWED_CHAT_ID=

# Cadena de conexion de Postgres (Supabase o Neon).
# Ejemplo: postgresql://usuario:clave@host:5432/basededatos?sslmode=require
#
# En Supabase usar la cadena del "Session pooler", NO la de "Direct
# connection": la directa (db.<ref>.supabase.co) solo funciona por IPv6, y los
# runners de GitHub Actions son IPv4. La del pooler tiene esta forma:
#   postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Y acordate de reemplazar el [YOUR-PASSWORD] que trae la cadena del panel.
DATABASE_URL=

# Access token de Mercado Pago (https://www.mercadopago.com.ar/developers/panel)
MERCADOPAGO_ACCESS_TOKEN=

# --- Opcionales -------------------------------------------------------------

# Base de datos aparte, solo para correr los tests de integracion.
# Si no esta seteada, esos tests se saltean.
TEST_DATABASE_URL=

# Modelo de faster-whisper para transcribir audios (tiny/base/small/medium)
WHISPER_MODEL=small

# Donde se cachea el modelo de whisper (lo usa GitHub Actions)
WHISPER_CACHE_DIR=modelos_whisper
